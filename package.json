{
  "name": "@unabandoned/crypto-js",
  "version": "4.2.0",
  "description": "JavaScript library of crypto standards.",
  "homepage": "https://github.com/unabandoned/crypto-js#readme",
  "author": {
    "name": "Evan Vosberg",
    "url": "http://github.com/evanvosberg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/crypto-js.git"
  },
  "bugs": {
    "url": "https://github.com/unabandoned/crypto-js/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "main": "index.js",
  "browser": {
    "crypto": false
  },
  "files": [
    "/*.js",
    "docs/",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "node scripts/build.mjs",
    "clean": "node -e \"for (const n of Object.keys(require('./scripts/modules.cjs'))) require('fs').rmSync(n + '.js', { force: true })\"",
    "test": "npm run build && node --test test/build.test.mjs test/upstream.test.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "security",
    "crypto",
    "Hash",
    "MD5",
    "SHA1",
    "SHA-1",
    "SHA256",
    "SHA-256",
    "RC4",
    "Rabbit",
    "AES",
    "DES",
    "PBKDF2",
    "HMAC",
    "OFB",
    "CFB",
    "CTR",
    "CBC",
    "Base64",
    "Base64url"
  ]
}
